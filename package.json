{
    "author": "JoshuaBrest <36625023+JoshuaBrest@users.noreply.github.com>",
    "dependencies": {
        "@date-fns/tz": "^1.5.0",
        "@hono/node-server": "^2.1.11",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.21",
        "jose": "^6.2.18",
        "mime-types": "^3.0.2",
        "pg": "^8.23.1",
        "qs": "^6.17.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.2",
        "zod": "^4.6.7"
    },
    "description": "Instructure Canvas LMS TRMNL plugin.",
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@rollup/plugin-alias": "^6.0.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-replace": "^6.0.3",
        "@rollup/plugin-swc": "^0.4.1",
        "@rollup/plugin-terser": "^1.0.2",
        "@swc/core": "^1.16.22",
        "@tailwindcss/postcss": "^4.3.5",
        "@types/mime-types": "^3.0.1",
        "@types/pg": "^8.23.1",
        "@types/qs": "^6.15.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "concurrently": "^10.0.7",
        "drizzle-kit": "^0.31.11",
        "postcss": "^8.5.33",
        "rollup": "^4.68.8",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-postcss": "^4.0.2",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "canvas",
        "lms",
        "trmnl"
    ],
    "license": "ISC",
    "main": "dist/index.cjs",
    "name": "canvas-trmnl",
    "packageManager": "pnpm@10.15.0",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@swc/core",
            "@tailwindcss/oxide",
            "esbuild"
        ]
    },
    "scripts": {
        "build": "NODE_ENV=production rollup -c --environment NODE_ENV:production",
        "check": "biome check --write",
        "dev": "NODE_ENV=development concurrently \"pnpm run watch --environment NODE_ENV:development\" \"node --env-file .env --watch ./dist/index.cjs\"",
        "drizzle:generate": "drizzle-kit generate",
        "drizzle:migrate": "drizzle-kit migrate",
        "drizzle:up": "drizzle-kit up",
        "start": "NODE_ENV=production node .",
        "typecheck": "tsc --noEmit",
        "watch": "rollup -c --watch"
    },
    "type": "module",
    "version": "1.0.0"
}
